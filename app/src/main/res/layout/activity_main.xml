<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#FFFFFF">

    <!-- Welcome / User Info -->
    <TextView
        android:id="@+id/welcomeText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Welcome!"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textAlignment="center"
        android:layout_marginBottom="4dp" />

    <!--
        NEW: shows the user's last cached mood (e.g. "Last mood: happy · Pop").
        Hidden by MainActivity when no cached mood exists yet.
    -->
    <TextView
        android:id="@+id/lastMoodText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="#888888"
        android:textAlignment="center"
        android:layout_marginBottom="28dp"
        android:visibility="gone" />

    <!-- Add Mood Button -->
    <Button
        android:id="@+id/moodButton"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="➕ Add Mood"
        android:textSize="18sp"
        android:layout_marginBottom="16dp" />

    <!-- Search YouTube Button -->
    <Button
        android:id="@+id/youtubeButton"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="🔍 Search Music"
        android:textSize="18sp"
        android:layout_marginBottom="16dp" />

    <!-- Favorites Button -->
    <Button
        android:id="@+id/favoritesButton"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="❤️ My Favorites"
        android:textSize="18sp"
        android:layout_marginBottom="16dp" />

    <!-- Logout Button -->
    <Button
        android:id="@+id/logoutButton"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="🚪 Logout"
        android:textSize="18sp"
        android:backgroundTint="#ff6b6b" />

</LinearLayout>